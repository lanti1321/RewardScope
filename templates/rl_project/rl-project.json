{
  "schema_version": 1,
  "project": "example-rl",
  "source_root": "src",
  "tasks": [
    {
      "id": "CartPole-Balance-v1",
      "algorithm": "PPO",
      "framework": "stable-baselines3",
      "simulator": "Gymnasium CartPole-v1",
      "environment": "example_rl.tasks.balance.env_cfg:make_env",
      "train": "example_rl.train:train",
      "step_dt": 0.02,
      "reward_scale": "none",
      "observation_groups": [
        "actor",
        "critic"
      ],
      "terminations": [
        "failure",
        "time_limit"
      ],
      "curricula": [],
      "rewards": [
        {
          "name": "alive",
          "function": "example_rl.tasks.balance.rewards:alive",
          "weight": 1.0,
          "enabled": true,
          "description": "CartPole base survival reward"
        },
        {
          "name": "angle",
          "function": "example_rl.tasks.balance.rewards:angle",
          "weight": -0.1,
          "enabled": true,
          "description": "Squared pole angle in radians"
        }
      ],
      "defaults": {
        "num_envs": 2,
        "total_timesteps": 256,
        "seed": 42,
        "network": {
          "type": "mlp",
          "actor": [
            32,
            32
          ],
          "critic": [
            32,
            32
          ],
          "activation": "tanh"
        }
      }
    }
  ]
}
